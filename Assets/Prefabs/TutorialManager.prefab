  directHitVolume: 1
  directHitSourceCount: 4
  attackPracticeStartMessage: "\uBC14\uB85C \uACF5\uACA9 \uD134\uC744 \uC5F0\uC2B5\uD574\uBCF4\uC790\uBAA8!"
  defensePracticeStartMessage: "\uBC29\uC5B4 \uD134\uC744  \uC5F0\uC2B5\uD574\uBCF4\uC790\uBAA8!"
  rallyPracticeStartMessage: "\uB7A0\uB9AC\uB97C \uC5F0\uC2B5\uD574\uBCF4\uC790\uBAA8!"
  practiceStartMessageBeats: 2
  playAttackBeatDemo: 1
  attackHighBeatDemoLineNumber: 3
  attackLowBeatDemoLineNumber: 4
  demoHighNotePositionRatio: 0.63
  demoLowNotePositionRatio: 0.37
  beatDemoDuration: 2
  demoFirstNoteId: 900000
  introGuideLines:
  - "\uC548\uB155, \uB0B4 \uC774\uB984\uC740 \uB9AC\uBAA8\uB2E4\uBAA8."
  - "\uB9AC\uB4EC\uC624\uBE57\uC758 \uD575\uC2EC, \uBE44\uD2B8\uB97C \uC54C\uB824\uC8FC\uACA0\uB2E4\uBAA8."
  - "\uBE44\uD2B8\uB294 \uC11C\uB85C \uC18C\uD1B5\uD558\uB294 \uBC15\uC790 \uC2E0\uD638\uB2E4\uBAA8."
  - "\uBE44\uD2B8\uB97C \uC870\uD569\uD574 \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0B4\uACE0,"
  - "\uBC1B\uC740 \uBE44\uD2B8\uB97C \uD574\uC11D\uD558\uBA70 \uC18C\uD1B5\uD55C\uB2E4\uBAA8."
  - "\uC870\uAE08 \uB4A4\uC5D0 \uC9C1\uC811 \uBE44\uD2B8\uB97C \uBCF4\uB0B4\uBCF4\uC790\uBAA8!"
  attackGuideLines:
  - "\uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0B4\uB294 \uD134\uC774 \uACF5\uACA9 \uD134\uC774\uB2E4\uBAA8."
  - "\uBAA9\uD45C \uD0ED \uC218\uB9CC\uD07C \uBE44\uD2B8\uB97C \uB9CC\uB4E4\uBA74
    \uB41C\uB2E4\uBAA8."
  - "F\uD0A4\uB294 \uBD84\uD64D\uC0C9 \uACE0\uC8FC\uD30C \uBE44\uD2B8,"
  - "J\uD0A4\uB294 \uCD08\uB85D\uC0C9 \uC800\uC8FC\uD30C \uBE44\uD2B8\uB2E4\uBAA8."
  - "\uC6D0\uD558\uB294 \uC870\uD569\uC73C\uB85C \uC785\uB825\uD558\uBA74,"
  - "\uC644\uC131\uD55C \uBE44\uD2B8\uAC00 \uC0C1\uB300\uC5D0\uAC8C \uB0A0\uC544\uAC00\uBAA8!"
  defenseGuideLines:
  - "\uB2E4\uC74C\uC740 \uBC29\uC5B4 \uD134\uC774\uB2E4\uBAA8."
  - "\uBE44\uD2B8\uAC00 \uD310\uC815\uC120\uC5D0 \uB2FF\uC744 \uB54C,"
  - "\uC885\uB958\uC5D0 \uB9DE\uB294 \uD0A4\uB97C \uB204\uB974\uB77C\uBAA8."
  - "\uD0C0\uC774\uBC0D\uACFC \uD0A4, \uB458 \uB2E4 \uC911\uC694\uD558\uB2E4\uBAA8!"
  rallyGuideLines:
  - "\uC774\uC81C \uC2E4\uC804 \uC5F0\uC2B5\uC774\uB2E4\uBAA8!"
  - "\uACF5\uACA9\uACFC \uBC29\uC5B4\uB97C \uBC88\uAC08\uC544 \uD558\uBA70,"
  - "\uC0C1\uB300\uC758 \uB9AC\uB4EC\uC744 \uC77D\uC5B4\uBCF4\uC790\uBAA8!"
  logInputRouting: 1
  logTurnFlow: 1
