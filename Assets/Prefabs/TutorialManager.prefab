  useDirectTutorialHitSfx: 1
  directHitHighClip: {fileID: 8300000, guid: 58cd19c2885857141a4109b8cc38acec, type: 3}
  directHitLowClip: {fileID: 8300000, guid: 4370489aa5b4b9e43966e1a7b3c47d74, type: 3}
  directHitVolume: 1
  directHitSourceCount: 4
  attackPracticeStartMessage: 
  defensePracticeStartMessage: 
  rallyPracticeStartMessage: 
  practiceStartMessageBeats: 2
  playAttackBeatDemo: 1
  beatDemoIntervalBeats: 1
  beatDemoClearLineNumber: 3
  demoHighNotePositionRatio: 0.63
  demoLowNotePositionRatio: 0.37
  beatDemoDuration: 2
  demoFirstNoteId: 900000
  highKeyHintColor: {r: 1, g: 0.35, b: 0.75, a: 1}
  lowKeyHintColor: {r: 0.35, g: 1, b: 0.45, a: 1}
  showIntroStarDemo: 1
  introStarDemoLineNumber: 3
  introStarDemoCount: 3
  introGuideLines:
  - text: "\uC548\uB155! \uB0B4 \uC774\uB984\uC740 \uB9AC\uBAA8. \uB9AC\uB4EC\uC624\uBE57\uC5D0
      \uC628 \uAC83\uC744 \uD658\uC601\uD558\uBAA8."
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uAD50\uC2E0\uD558\uB294 \uBC29\uBC95\uC5D0 \uB300\uD574 \uBE60\uB974\uAC8C
      \uC54C\uB824\uC8FC\uACA0\uB2E4\uBAA8!"
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uC624\uB978\uCABD \uC544\uB798 <b>\uBCC4 \uBAA8\uC591</b>\uC758 \uBE44\uD2B8\uAC00
      \uBCF4\uC774\uC9C0\uBAA8?"
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 1
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uACF5\uACA9 \uD134\uC774 \uB418\uBA74 <b>\uBCC4 \uC218\uB9CC\uD07C</b>
      \uBE44\uD2B8\uB97C \uC785\uB825\uD574\uC57C \uD574\uBAA8."
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 1
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uBCC4 \uC218\uBCF4\uB2E4 \uB9CE\uC774 \uCE58\uAC70\uB098 \uC801\uAC8C
      \uCE58\uBA74 \uC548 \uB41C\uB2E4\uBAA8!"
    rymoPortrait: {fileID: 5377859178988851676, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uC774\uC81C \uC9C1\uC811 \uBE44\uD2B8\uB97C \uBCF4\uB0B4\uBCF4\uC790\uBAA8!"
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  attackGuideLines:
  - text: "\uACF5\uACA9 \uD134\uC740 <b><color=#FF66BF>F</color> / <color=#59FF73>J</color></b>
      \uD0A4\uB85C \uBE44\uD2B8\uB97C \uBCF4\uB0BC \uC218 \uC788\uBAA8."
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 1
  - text: "<b><color=#FF66BF>F</color></b>\uB294 <b><color=#FF66BF>\uBD84\uD64D\uC0C9
      \uACE0\uC8FC\uD30C</color></b>, <b><color=#59FF73>J</color></b>\uB294 <b><color=#59FF73>\uCD08\uB85D\uC0C9
      \uC800\uC8FC\uD30C</color></b> \uBE44\uD2B8\uB2E4\uBAA8."
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 1
    highlightLowBit: 1
    playHighThenLowDemo: 0
  - text: "\uAE4C\uBA39\uC9C0 \uC54A\uAC8C \uBBF8\uB9AC \uC678\uC6CC\uB450\uB294
      \uAC83\uC774 \uC88B\uACA0\uC9C0\uBAA8?"
    rymoPortrait: {fileID: -5725962078152895296, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uB808\uC778\uC5D0 <b>\uD310\uC815\uC120</b>\uC774 \uC9C0\uB098\uAC08
      \uB54C \uBE44\uD2B8\uB97C \uC785\uB825\uD574\uBAA8."
    rymoPortrait: {fileID: -8401692288953904933, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 1
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uBC29 \uC0DD\uC131\uC790\uB294 <b><color=#FF66BF>\uBD84\uD64D\uC0C9</color></b>,
      \uBC29 \uCC38\uAC00\uC790\uB294 <b><color=#59FF73>\uCD08\uB85D\uC0C9</color></b>\uC774\uB2E4\uBAA8."
    rymoPortrait: {fileID: 7152930139536384079, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uC9C0\uAE08 \uC5F0\uC2B5\uD560 \uB550 <b><color=#FF66BF>\uBD84\uD64D\uC0C9</color></b>\uC774\uB2E4\uBAA8!
      \uACF5\uACA9 \uC2DC\uC791\uC774\uB2E4\uBAA8!"
    rymoPortrait: {fileID: -8090365562718305141, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  defenseGuideLines:
  - text: "\uD6CC\uB96D\uD558\uB2E4\uBAA8! \uADF8\uB7FC \uBC29\uC5B4 \uD134\uC744
      \uBC30\uC6CC\uBCF4\uC790\uBAA8."
    rymoPortrait: {fileID: -8401692288953904933, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uC544\uAE4C \uC124\uBA85\uD55C \uD310\uC815\uC120 \uC0C9\uAE54 \uAE30\uC5B5\uD558\uC9C0\uBAA8?"
    rymoPortrait: {fileID: -5725962078152895296, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uBE44\uD2B8\uAC00 \uD310\uC815\uC120\uC5D0 \uB2E4\uAC00\uC62C \uB54C
      <b><color=#FF66BF>F</color> / <color=#59FF73>J</color></b> \uD0A4\uB97C \uB20C\uB7EC\uBAA8!"
    rymoPortrait: {fileID: -8401692288953904933, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 1
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "<b>\uD0A4</b>, <b>\uD310\uC815 \uD0C0\uC774\uBC0D</b>\uC744 \uC8FC\uC758\uD558\uBA74\uC11C
      \uBC29\uC5B4\uD574 \uBCF4\uC790\uBAA8!"
    rymoPortrait: {fileID: -8090365562718305141, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  rallyGuideLines:
  - text: "\uBA4B\uC788\uB294\uB370\uBAA8! \uC774\uC81C <b>\uC2E4\uC804 \uC5F0\uC2B5</b>\uC744
      \uD574\uBCFC\uAE4C\uBAA8?"
    rymoPortrait: {fileID: -8401692288953904933, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uACF5\uACA9 \uD134\uACFC \uBC29\uC5B4 \uD134\uC744 \uBC88\uAC08\uC544
      \uD574\uC57C \uD558\uBAA8."
    rymoPortrait: {fileID: -8090365562718305141, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  - text: "\uC790 \uC774\uC81C \uC0C1\uB300\uC640 \uB9AC\uB4EC\uC744 \uC8FC\uACE0\uBC1B\uC73C\uBA70
      \uC990\uACA8\uBCF4\uC790\uBAA8!"
    rymoPortrait: {fileID: -8090365562718305141, guid: 17676ff2119e8c446a17857a3b11fb82, type: 3}
    highlightStars: 0
    highlightAttackJudgeLine: 0
    highlightDefenseJudgeLine: 0
    highlightHighBit: 0
    highlightLowBit: 0
    playHighThenLowDemo: 0
  logInputRouting: 1
  logTurnFlow: 1
