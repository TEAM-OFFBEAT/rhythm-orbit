  introLowNotePositionRatio: 0.37
  introBeatDemoDuration: 2
  introSecondNoteDelayBeats: 1
  introDemoFirstNoteId: 900000
  introGuideLines:
  - "\uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC! \uD29C\uD1A0\uB9AC\uC5BC\uC744 \uB3C4\uC640\uC904
    \uB9AC\uBAA8\uC57C."
  - "\uB9AC\uB4EC\uC624\uBE57\uC758 \uD575\uC2EC \uC694\uC18C\uC778 \uBE44\uD2B8\uC5D0
    \uB300\uD574 \uC124\uBA85\uD574\uC904\uAC8C."
  - "\uBE44\uD2B8\uB294 \uC0C1\uB300\uC640 \uD1B5\uC2E0\uD560 \uC218 \uC788\uAC8C
    \uD574\uC8FC\uB294 \uBC15\uC790 \uC2E0\uD638\uC57C."
  - "\uBCF4\uB0B4\uACE0 \uC2F6\uC740 \uBA54\uC2DC\uC9C0\uB97C \uBE44\uD2B8 \uC870\uD569\uC73C\uB85C
    \uC804\uC1A1\uD558\uACE0, "
  - "\uC218\uC2E0\uD55C \uBE44\uD2B8\uB97C \uD574\uC11D\uD558\uBA70 \uC18C\uD1B5\uD560
    \uC218 \uC788\uC9C0."
  - "\uBE44\uD2B8\uB294 \uACE0\uC8FC\uD30C \uBE44\uD2B8, \uC800\uC8FC\uD30C \uBE44\uD2B8\uAC00
    \uC0AC\uC6A9\uB418\uACE0 \uC788\uC5B4."
  - "\uC55E\uC73C\uB85C \uC774 \uB450 \uC885\uB958\uC758 \uBE44\uD2B8\uB97C \uBCF4\uB0B4\uACE0
    \uBC1B\uB294 \uC77C\uC774 \uBC18\uBCF5\uB420 \uAC70\uC57C! "
  attackGuideLines:
  - "\uACF5\uACA9 \uD134\uC5D0 \uB300\uD574 \uC124\uBA85\uD574\uC904\uAC8C."
  - "\uACF5\uACA9 \uD134\uC5D0\uB294 \uBAA9\uD45C \uD0ED \uC218\uB9CC\uD07C \uD0A4\uB97C
    \uC785\uB825\uD558\uC5EC \uBE44\uD2B8\uB97C \uC0DD\uC131\uD574\uC57C \uD574."
  - "F\uD0A4\uB85C \uACE0\uC8FC\uD30C \uBE44\uD2B8\uB97C, J\uD0A4\uB85C\uB294 \uC800\uC8FC\uD30C
    \uBE44\uD2B8\uB97C \uC0DD\uC131\uD560 \uC218 \uC788\uC5B4."
  - "\uD310\uC815\uC120\uC5D0 \uD0C0\uC774\uBC0D\uC744 \uB9DE\uCDB0, \uC6D0\uD558\uB294
    \uC870\uD569\uB300\uB85C \uBE44\uD2B8\uB97C \uC785\uB825\uD558\uBA74 \uB3FC."
  - "\uC0DD\uC131\uD55C \uBE44\uD2B8\uB294 \uBC14\uB85C \uC0C1\uB300 \uC9C4\uC601\uC73C\uB85C
    \uB118\uC5B4\uAC00\uAC8C \uB3FC."
  - "\uBE44\uD2B8\uC758 \uC870\uD569\uC740 \uC6D0\uD558\uB294\uB300\uB85C \uAD6C\uC131\uD560
    \uC218 \uC788\uC9C0\uB9CC, \uBAA9\uD45C \uD0ED \uC218\uB97C \uC9C0\uCF1C\uC57C
    \uD568\uC744 \uAE30\uC5B5\uD574!"
  - "\uC790, \uACF5\uACA9 \uC5F0\uC2B5\uC744 \uD55C \uBC88 \uD574\uBCF4\uC790. "
  defenseGuideLines:
  - "\uC88B\uC544! \uC774\uBC88\uC5D4 \uBC29\uC5B4 \uD134\uC5D0 \uB300\uD574 \uC124\uBA85\uD574\uC904\uAC8C."
  - "\uC0C1\uB300\uC758 \uBE44\uD2B8\uAC00 \uC6B0\uB9AC \uC9C4\uC601\uC73C\uB85C
    \uB118\uC5B4\uC624\uBA74, \uD0C0\uC774\uBC0D\uC744 \uB9DE\uCDB0\uC11C \uD0A4\uB97C
    \uB204\uB974\uC790."
  - "\uBC29\uC5B4 \uD134\uC5D0\uC11C\uB294 \uBE44\uD2B8 \uC885\uB958\uC5D0 \uB530\uB77C
    \uC62C\uBC14\uB978 \uD0A4\uB85C \uBC29\uC5B4\uD574\uC57C \uD574."
  - "\uACE0\uC8FC\uD30C \uBE44\uD2B8\uB294 F\uD0A4, \uC800\uC8FC\uD30C \uBE44\uD2B8\uB294
    J\uD0A4\uB85C \uBC29\uC5B4\uD558\uB294 \uAC70\uC57C."
  - "\uC138 \uBC88 \uC815\uB3C4\uB9CC \uC5F0\uC2B5\uD574\uBCF4\uC790!"
  rallyGuideLines:
  - "\uC798 \uD588\uC5B4! \uC774\uC81C \uC2E4\uC804 \uC5F0\uC2B5\uC774\uC57C."
  - "\uACF5\uACA9\uD134\uACFC \uBC29\uC5B4\uD134\uC744 \uBC18\uBCF5\uD558\uBA70 \uBE44\uD2B8\uB97C
    \uC8FC\uACE0 \uBC1B\uB294 \uC5F0\uC2B5\uC774\uC57C."
  - "\uC0C1\uB300\uC758 \uB9AC\uB4EC\uC5D0 \uADC0 \uAE30\uC6B8\uC774\uACE0, \uC6B0\uB9AC\uC758
    \uB9AC\uB4EC\uC73C\uB85C \uD574\uC11D\uD574\uBCF4\uC790!"
  attackPracticeMessage: "\uC548\uB155"
  attackPracticeTargetTapCount: 2
