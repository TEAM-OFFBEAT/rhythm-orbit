  m_Script: {fileID: 11500000, guid: 47dd6c0262cc97c4a9539e37f76aed68, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroDialogueController
  dialoguePlayer: {fileID: 1549251834048446401}
  introLines:
  - dialogue:
      text: "\uB9AC\uB4EC\uC624\uBE57\uC744 \uC990\uAE30\uB294 \uC5EC\uB7EC\uBD84,
        \uD658\uC601\uD569\uB2C8\uB2E4!"
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 0
  - dialogue:
      text: "\uC5EC\uB7EC\uBD84\uC740 \uC11C\uB85C \uBE44\uD2B8\uB97C \uC8FC\uACE0\uBC1B\uC73C\uBA70
        \uB0AF\uC120 \uC0C1\uB300\uC640 \uAD50\uC2E0\uD558\uAC8C \uB429\uB2C8\uB2E4."
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 0
  - dialogue:
      text: "\uCC98\uC74C <b>\uACF5\uACA9 \uD134</b>\uC744 \uAC00\uC9C0\uB294 \uD50C\uB808\uC774\uC5B4\uB294
        <b><color=#FF66BF>OBIT</color></b>\uC785\uB2C8\uB2E4."
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 1
    highlightP2Panel: 0
  - dialogue:
      text: "\uC9C0\uAD6C\uC778 <b><color=#FF66BF>OBIT</color></b>\uC774 \uC678\uACC4
        \uC885\uC871 <b><color=#59FF73>RYMO</color></b>\uC758 \uC624\uBB18\uD55C
        \uC2E0\uD638\uB97C \uCE90\uCE58\uD588\uAC70\uB4E0\uC694!"
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 0
  - dialogue:
      text: "\uBA3C\uC800 \uBE44\uD2B8\uB97C \uBCF4\uB0B4\uB294 <b><color=#FF66BF>OBIT</color></b>,
        \uC774\uC81C \uC6B0\uC8FC\uB85C\uBD80\uD130 \uC2E0\uD638\uAC00 \uB418\uB3CC\uC544\uC624\uACA0\uC8E0?"
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 0
  - dialogue:
      text: "<b><color=#59FF73>RYMO</color></b> \uD50C\uB808\uC774\uC5B4\uB294 <b>\uBC29\uC5B4
        \uD134</b>\uC73C\uB85C \uAC8C\uC784\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 1
  - dialogue:
      text: "\uD50C\uB808\uC774 \uC911 <b>BPM</b>\uC740 \uCD1D <b>2\uBC88 \uC99D\uAC00</b>\uD569\uB2C8\uB2E4."
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 0
  - dialogue:
      text: "\uC27D\uC9C0\uB294 \uC54A\uACA0\uC9C0\uB9CC, \uC0C1\uB300\uC640 \uB9AC\uB4EC\uC744
        \uB7A0\uB9AC\uD558\uB4EF \uC990\uACA8\uBCF4\uC138\uC694!"
      rymoPortrait: {fileID: 0}
      highlightStars: 0
      highlightAttackJudgeLine: 0
      highlightDefenseJudgeLine: 0
      highlightHighBit: 0
      highlightLowBit: 0
      playHighThenLowDemo: 0
    highlightP1Panel: 0
    highlightP2Panel: 0
  beatsPerLine: 4
  p1Slot: {fileID: 0}
  p2Slot: {fileID: 0}
